{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSCL Setup",
  "version": "0.1.0",
  "identifier": "com.mscl.installer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSCL 安装程序",
        "width": 840,
        "height": 620,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-http-cache --disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "MSCL Team",
    "copyright": "Copyright © 2026 MSCL Team",
    "shortDescription": "MSCL 月之海启动器 安装程序",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
